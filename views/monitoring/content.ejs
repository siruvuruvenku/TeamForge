<section class="page-heading"><div><div class="eyebrow">OPERATIONAL VISIBILITY</div><h1>Service health<span class="heading-period">.</span></h1><p>Know when your services need attention.</p></div><% if(['admin','manager'].includes(currentUser.role)){ %><button class="button button-primary" data-modal-open="service-modal"><i class="bi bi-plus-lg"></i> Add service</button><% } %></section>
<div class="notice-banner"><span class="notice-icon"><i class="bi bi-info-circle"></i></span><div><strong>Scheduled checks run every five minutes on Vercel.</strong><span>Set <code>CRON_SECRET</code> and configure the same value in your deployment environment.</span></div></div><section class="service-grid"><% services.forEach(service=>{ %><article class="panel service-card"><div class="service-card-head"><span class="service-icon"><i class="bi bi-hdd-network"></i></span><span class="pill status-<%= service.status %>"><span></span><%= service.status %></span></div><h2><%= service.name %></h2><a href="<%= service.url %>" target="_blank" rel="noreferrer"><%= service.url %></a><div class="service-meta"><span><i class="bi bi-globe2"></i> <%= service.environment %></span><span><i class="bi bi-person"></i> <%= service.owner || 'No owner' %></span></div><footer><span>Response <strong><%= service.responseTime == null ? '—' : service.responseTime+' ms' %></strong></span><span>Checked <strong><%= service.lastCheckedAt ? new Intl.DateTimeFormat('en',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}).format(service.lastCheckedAt) : 'Not yet' %></strong></span></footer></article><% }) %><% if(!services.length){ %><div class="panel empty-docs"><span class="empty-icon"><i class="bi bi-activity"></i></span><strong>No services registered</strong><span>Add a public HTTP endpoint to begin tracking its availability.</span><% if(['admin','manager'].includes(currentUser.role)){ %><button class="button button-secondary" data-modal-open="service-modal">Add first service</button><% } %></div><% } %></section>
<div class="modal-backdrop" id="service-modal"><div class="modal-card"><div class="modal-heading"><div><h2>Register a service</h2><p>TeamForge will check its HTTP availability.</p></div><button class="icon-button" data-modal-close><i class="bi bi-x-lg"></i></button></div><form data-api-form="/api/monitoring/services" data-refresh><label>Service name<input name="name" required maxlength="120" placeholder="Public API"></label><label>Health URL<input name="url" type="url" required placeholder="https://api.example.com/health"></label><div class="form-two"><label>Environment<input name="environment" value="production"></label><label>Owner<input name="owner" placeholder="Platform team"></label></div><div class="modal-actions"><button type="button" class="button button-secondary" data-modal-close>Cancel</button><button class="button button-primary" type="submit">Add service</button></div></form></div></div>
