<header class="topbar"><button class="icon-button mobile-menu" id="menu-toggle" aria-label="Toggle navigation"><i class="bi bi-list"></i></button><div class="breadcrumb"><span>Workspace</span><i class="bi bi-chevron-right"></i><strong><%= title %></strong></div><div class="topbar-actions"><label class="search-box"><i class="bi bi-search"></i><input id="global-search" placeholder="Search anything…" autocomplete="off"><kbd>⌘ K</kbd></label><a class="icon-button notification-button" href="/notifications" aria-label="Notifications"><i class="bi bi-bell"></i></a><div class="topbar-divider"></div><div class="profile-wrap"><button class="profile-button" id="profile-menu"><span class="avatar"><%= (currentUser?.name || 'U').split(' ').map(x=>x[0]).slice(0,2).join('').toUpperCase() %></span><span class="profile-name"><strong><%= currentUser?.name || 'User' %></strong><small><%= currentUser?.role || '' %></small></span><i class="bi bi-chevron-down"></i></button><div class="profile-dropdown" id="profile-dropdown"><span><%= currentUser?.email || '' %></span><button id="logout-button"><i class="bi bi-box-arrow-right"></i> Sign out</button></div></div></div></header>
