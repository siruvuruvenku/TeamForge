<section class="page-heading"><div><div class="eyebrow">YOUR WORKSPACE</div><h1>Projects<span class="heading-period">.</span></h1><p>Plan and track the work your team is building.</p></div><% if (['admin','manager'].includes(currentUser.role)) { %><button class="button button-primary" data-modal-open="project-modal"><i class="bi bi-plus-lg"></i> New project</button><% } %></section>
<div class="toolbar"><label class="search-box table-search"><i class="bi bi-search"></i><input data-filter="project-row" placeholder="Find a project…"></label><span class="result-count"><%= projects.length %> projects</span></div>
<section class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>PROJECT</th><th>STATUS</th><th>OWNER</th><th>DUE DATE</th><th>UPDATED</th><th></th></tr></thead><tbody id="project-table"><% projects.forEach((project) => { %><tr data-filter-row="project-row"><td><div class="project-cell"><span class="project-avatar"><%= project.key.slice(0,1) %></span><div><strong><%= project.name %></strong><small><%= project.key %> · <%= project.description || 'No description yet' %></small></div></div></td><td><span class="pill status-<%= project.status %>"><span></span><%= project.status %></span></td><td><%= project.owner?.name || '—' %></td><td><%= project.dueDate || '—' %></td><td><%= new Intl.DateTimeFormat('en',{month:'short',day:'numeric'}).format(project.updatedAt) %></td><td><button class="icon-button row-delete" data-delete="/api/projects/<%= project.id %>" aria-label="Delete project"><i class="bi bi-three-dots"></i></button></td></tr><% }) %><% if (!projects.length) { %><tr class="empty-row"><td colspan="6"><div class="empty-state"><span class="empty-icon"><i class="bi bi-kanban"></i></span><strong>No projects yet</strong><span>Create a project to give your team's work a home.</span></div></td></tr><% } %></tbody></table></div></section>
<div class="modal-backdrop" id="project-modal"><div class="modal-card"><div class="modal-heading"><div><h2>Create a project</h2><p>Set up a home for a new stream of work.</p></div><button class="icon-button" data-modal-close aria-label="Close"><i class="bi bi-x-lg"></i></button></div><form data-api-form="/api/projects" data-refresh><label>Project name<input name="name" required minlength="2" maxlength="160" placeholder="Developer experience"></label><label>Project key<input name="key" required pattern="[A-Z][A-Z0-9]{1,11}" maxlength="12" placeholder="DEVX" autocapitalize="characters"></label><label>Description<textarea name="description" rows="3" placeholder="What is this project about?"></textarea></label><label>Target date<input name="dueDate" type="date"></label><div class="modal-actions"><button type="button" class="button button-secondary" data-modal-close>Cancel</button><button class="button button-primary" type="submit">Create project</button></div></form></div></div>
