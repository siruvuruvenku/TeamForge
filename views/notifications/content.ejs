<section class="page-heading"><div><div class="eyebrow">STAY IN THE LOOP</div><h1>Notifications<span class="heading-period">.</span></h1><p>Updates from projects and teammates.</p></div><button class="button button-secondary" id="mark-all-read"><i class="bi bi-check2-all"></i> Mark all read</button></section>
<section class="panel notification-list"><% notifications.forEach(n=>{ %><article class="notification-item <%= n.readAt?'read':'' %>"><span class="notification-icon"><i class="bi <%= n.type==='build'?'bi-exclamation-triangle':n.type==='task'?'bi-check2-square':'bi-bell' %>"></i></span><div><p><%= n.message %></p><small><%= new Intl.DateTimeFormat('en',{month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}).format(n.createdAt) %></small></div><% if(!n.readAt){ %><button class="text-link" data-read="/api/notifications/<%= n.id %>/read">Mark read</button><% } %></article><% }) %><% if(!notifications.length){ %><div class="empty-state"><span class="empty-icon"><i class="bi bi-bell-slash"></i></span><strong>All caught up</strong><span>New updates will show up here.</span></div><% } %></section>
