<section class="page-heading"><div><div class="eyebrow"><span class="pulse-dot"></span><%= new Intl.DateTimeFormat('en', {month:'long', day:'numeric', year:'numeric'}).format(new Date()) %></div><h1>Good work starts here<span class="heading-period">.</span></h1><p>Your engineering workspace at a glance.</p></div><a class="button button-primary" href="/tasks"><i class="bi bi-plus-lg"></i> New task</a></section>
<section class="stats-grid"><article class="stat-card"><div class="stat-top"><span class="stat-label">Total projects</span><span class="stat-icon indigo"><i class="bi bi-kanban"></i></span></div><strong><%= stats.projects %></strong><div class="stat-foot"><span class="status-dot blue"></span><%= stats.activeProjects %> active projects</div></article><article class="stat-card"><div class="stat-top"><span class="stat-label">Open tasks</span><span class="stat-icon amber"><i class="bi bi-check2-square"></i></span></div><strong><%= stats.openTasks %></strong><div class="stat-foot"><span class="status-dot amber-dot"></span><%= stats.completedTasks %> completed</div></article><article class="stat-card"><div class="stat-top"><span class="stat-label">Team members</span><span class="stat-icon mint"><i class="bi bi-people"></i></span></div><strong><%= stats.developers %></strong><div class="stat-foot"><span class="status-dot green"></span>Active accounts</div></article><article class="stat-card"><div class="stat-top"><span class="stat-label">Failed builds</span><span class="stat-icon rose"><i class="bi bi-exclamation-triangle"></i></span></div><strong><%= stats.failedBuilds ?? 'N/A' %></strong><div class="stat-foot muted"><i class="bi bi-info-circle"></i> Connect GitHub Actions</div></article></section>
<section class="content-grid dashboard-grid"><article class="panel chart-panel"><div class="panel-heading"><div><h2>Task progress</h2><p>Current work across your workspace</p></div><a class="text-link" href="/tasks">View tasks <i class="bi bi-arrow-up-right"></i></a></div><div class="chart-wrap"><canvas id="task-chart" data-chart='<%= JSON.stringify(taskCounts.map(x => ({status:x.status,count:Number(x.count)}))) %>' aria-label="Task status chart"></canvas><div class="chart-empty" id="task-chart-empty" <%= taskCounts.length ? 'hidden' : '' %>><span class="empty-icon"><i class="bi bi-bar-chart"></i></span><strong>Your progress will show up here</strong><span>Create tasks to start tracking work.</span></div></div></article><article class="panel activity-panel"><div class="panel-heading"><div><h2>Recent activity</h2><p>The latest from your team</p></div><span class="live-label"><span class="pulse-dot"></span>LIVE</span></div><div class="activity-list"><% if (!activities.length) { %><div class="empty-activity"><span class="empty-icon"><i class="bi bi-chat-square-dots"></i></span><strong>A little quiet in here</strong><span>Team updates will appear as work happens.</span></div><% } %><% activities.forEach((activity) => { %><div class="activity-item"><span class="activity-icon"><i class="bi <%= activity.type === 'project_created' ? 'bi-kanban' : activity.type === 'task_completed' ? 'bi-check2-circle' : activity.type === 'user_joined' ? 'bi-person-plus' : 'bi-lightning' %>"></i></span><div><p><%= activity.message %></p><small><%= activity.actor?.name || 'TeamForge' %> · <%= new Intl.DateTimeFormat('en', {month:'short',day:'numeric',hour:'numeric',minute:'2-digit'}).format(activity.createdAt) %></small></div></div><% }) %></div></article></section>
<section class="panel project-summary"><div class="panel-heading"><div><h2>Project portfolio</h2><p>Keep an eye on what's moving forward.</p></div><a class="button button-secondary button-sm" href="/projects">All projects <i class="bi bi-arrow-right"></i></a></div><% if(recentProjects.length){ %><div class="recent-project-list"><% recentProjects.forEach(project=>{ %><a class="recent-project" href="/projects"><span class="project-avatar"><%= project.key.slice(0,1) %></span><span><strong><%= project.name %></strong><small><%= project.key %> · <%= project.owner?.name || 'No owner' %></small></span><span class="pill status-<%= project.status %>"><span></span><%= project.status %></span><i class="bi bi-arrow-up-right"></i></a><% }) %></div><% } else { %><div class="portfolio-empty"><span class="empty-icon"><i class="bi bi-kanban"></i></span><div><strong>Your project portfolio starts here</strong><p>Create a project to organize work, set a direction, and bring your team together.</p></div><a class="text-link" href="/projects">Go to projects <i class="bi bi-arrow-right"></i></a></div><% } %></section>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.8/dist/chart.umd.min.js"></script>
