<section class="page-heading"><div><div class="eyebrow">MAKE PROGRESS VISIBLE</div><h1>Tasks<span class="heading-period">.</span></h1><p>Turn plans into small, trackable steps.</p></div><button class="button button-primary" data-modal-open="task-modal"><i class="bi bi-plus-lg"></i> New task</button></section>
<div class="toolbar"><label class="search-box table-search"><i class="bi bi-search"></i><input data-filter="task-row" placeholder="Find a task…"></label><div class="filter-group"><span><i class="bi bi-funnel"></i> Status</span><select id="task-status-filter"><option value="">All statuses</option><option value="backlog">Backlog</option><option value="todo">To do</option><option value="in_progress">In progress</option><option value="review">In review</option><option value="done">Done</option></select></div><span class="result-count"><%= tasks.length %> tasks</span></div>
<section class="panel table-panel"><div class="table-scroll"><table><thead><tr><th>TASK</th><th>STATUS</th><th>PRIORITY</th><th>PROJECT</th><th>ASSIGNEE</th><th>DUE DATE</th><th></th></tr></thead><tbody><% tasks.forEach(task=>{ %><tr data-filter-row="task-row" data-status="<%= task.status %>"><td><div class="task-title"><span class="task-square"><i class="bi bi-check2"></i></span><strong><%= task.title %></strong></div></td><td><select class="inline-select task-status" data-id="<%= task.id %>"><option value="backlog" <%= task.status==='backlog'?'selected':'' %>>Backlog</option><option value="todo" <%= task.status==='todo'?'selected':'' %>>To do</option><option value="in_progress" <%= task.status==='in_progress'?'selected':'' %>>In progress</option><option value="review" <%= task.status==='review'?'selected':'' %>>In review</option><option value="done" <%= task.status==='done'?'selected':'' %>>Done</option></select></td><td><span class="priority priority-<%= task.priority %>"><i class="bi bi-flag-fill"></i><%= task.priority %></span></td><td><span class="project-key"><%= task.Project?.key || '—' %></span></td><td><%= task.assignee?.name || 'Unassigned' %></td><td><%= task.dueDate || '—' %></td><td><button class="icon-button row-delete" data-delete="/api/tasks/<%= task.id %>" aria-label="Delete task"><i class="bi bi-trash3"></i></button></td></tr><% }) %><% if(!tasks.length){ %><tr><td colspan="7"><div class="empty-state"><span class="empty-icon"><i class="bi bi-check2-square"></i></span><strong>No tasks to work on</strong><span>Create a task and keep the next step clear.</span></div></td></tr><% } %></tbody></table></div></section>
<div class="modal-backdrop" id="task-modal"><div class="modal-card"><div class="modal-heading"><div><h2>Create a task</h2><p>Small steps make meaningful progress.</p></div><button class="icon-button" data-modal-close><i class="bi bi-x-lg"></i></button></div><form data-api-form="/api/tasks" data-refresh><label>Task title<input name="title" required maxlength="200" placeholder="Add a clear, actionable title"></label><label>Project<select name="projectId" required><option value="">Select a project</option><% projects.forEach(p=>{ %><option value="<%= p.id %>"><%= p.name %> · <%= p.key %></option><% }) %></select></label><label>Description<textarea name="description" rows="3"></textarea></label><div class="form-two"><label>Priority<select name="priority"><option>low</option><option selected>medium</option><option>high</option><option>urgent</option></select></label><label>Assign to<select name="assigneeId"><option value="">Unassigned</option><% users.forEach(u=>{ %><option value="<%= u.id %>"><%= u.name %></option><% }) %></select></label></div><label>Due date<input name="dueDate" type="date"></label><div class="modal-actions"><button type="button" class="button button-secondary" data-modal-close>Cancel</button><button class="button button-primary" type="submit">Create task</button></div></form></div></div>
