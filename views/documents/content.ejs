<section class="page-heading"><div><div class="eyebrow">SHARED TEAM KNOWLEDGE</div><h1>Knowledge base<span class="heading-period">.</span></h1><p>Technical decisions and documentation your team can find.</p></div><button class="button button-primary" data-modal-open="document-modal"><i class="bi bi-plus-lg"></i> New document</button></section>
<div class="toolbar"><label class="search-box table-search"><i class="bi bi-search"></i><input data-filter="document-card" placeholder="Search documents…"></label><span class="result-count"><%= documents.length %> documents</span></div><section class="document-grid"><% documents.forEach(doc=>{ %><article class="document-card" data-filter-row="document-card"><div class="document-card-top"><span class="document-icon"><i class="bi bi-file-earmark-text"></i></span><span class="pill status-<%= doc.status %>"><span></span><%= doc.status %></span></div><h2><%= doc.title %></h2><p><%= doc.content.slice(0,130) || 'No content yet' %><%= doc.content.length>130?'…':'' %></p><footer><span><i class="bi bi-person-circle"></i> <%= doc.author?.name || 'Unknown author' %></span><span>v<%= doc.version %></span></footer><div class="document-actions"><button class="text-link" data-doc-edit="<%= doc.id %>" data-title="<%= doc.title %>" data-content="<%= doc.content %>">Edit <i class="bi bi-arrow-up-right"></i></button><% if(doc.status!=='published' && ['admin','manager'].includes(currentUser.role)){ %><button class="text-link" data-publish="/api/documents/<%= doc.id %>/publish">Publish <i class="bi bi-send"></i></button><% } %></div></article><% }) %><% if(!documents.length){ %><div class="panel empty-docs"><span class="empty-icon"><i class="bi bi-journal-plus"></i></span><strong>Start your team's knowledge base</strong><span>Write down the decisions, patterns, and guides your team relies on.</span><button class="button button-secondary" data-modal-open="document-modal">Create first document</button></div><% } %></section>
<div class="modal-backdrop" id="document-modal"><div class="modal-card modal-wide"><div class="modal-heading"><div><h2 id="document-modal-title">New document</h2><p>Share the context that helps your team move faster.</p></div><button class="icon-button" data-modal-close><i class="bi bi-x-lg"></i></button></div><form id="document-form" data-api-form="/api/documents" data-refresh><input type="hidden" name="id"><label>Document title<input name="title" required maxlength="200" placeholder="e.g. Deployment runbook"></label><label>Content<textarea name="content" rows="12" placeholder="Write your documentation here… Markdown-style plain text is supported."></textarea></label><div class="editor-hint"><i class="bi bi-info-circle"></i> Content is safely stored as plain text. Revisions are saved when you update.</div><div class="modal-actions"><button type="button" class="button button-secondary" data-modal-close>Cancel</button><button class="button button-primary" type="submit">Save draft</button></div></form></div></div>
