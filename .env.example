NODE_ENV=development
PORT=3000
SESSION_SECRET=replace-with-a-long-random-secret
# For Vercel, provide a managed MySQL URL (for example, from a MySQL-compatible provider).
DATABASE_URL=mysql://user:password@host:3306/teamforge
# Optional bootstrap administrator; used only when the database is first initialized.
ADMIN_NAME=TeamForge Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password
# Optional GitHub integration. Keep tokens server-side.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_WEBHOOK_SECRET=
CRON_SECRET=
